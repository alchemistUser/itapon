{
  "components": {
    "schemas": {
      "BBox": {
        "description": "Normalized to 0\u20131 so clients can draw overlays at any size.",
        "properties": {
          "x1": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X1",
            "type": "number"
          },
          "x2": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "X2",
            "type": "number"
          },
          "y1": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y1",
            "type": "number"
          },
          "y2": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Y2",
            "type": "number"
          }
        },
        "required": [
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "title": "BBox",
        "type": "object"
      },
      "Body_detect_v1_detect_post": {
        "properties": {
          "image": {
            "contentMediaType": "application/octet-stream",
            "title": "Image",
            "type": "string"
          }
        },
        "required": [
          "image"
        ],
        "title": "Body_detect_v1_detect_post",
        "type": "object"
      },
      "ClassInfo": {
        "properties": {
          "class_key": {
            "title": "Class Key",
            "type": "string"
          },
          "default_category": {
            "enum": [
              "biodegradable",
              "recyclable",
              "residual",
              "hazardous"
            ],
            "title": "Default Category",
            "type": "string"
          }
        },
        "required": [
          "class_key",
          "default_category"
        ],
        "title": "ClassInfo",
        "type": "object"
      },
      "DetectResponse": {
        "properties": {
          "detections": {
            "items": {
              "$ref": "#/components/schemas/Detection"
            },
            "title": "Detections",
            "type": "array"
          },
          "image": {
            "$ref": "#/components/schemas/ImageSize"
          },
          "inference_ms": {
            "title": "Inference Ms",
            "type": "integer"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          }
        },
        "required": [
          "model_version",
          "inference_ms",
          "image",
          "detections"
        ],
        "title": "DetectResponse",
        "type": "object"
      },
      "Detection": {
        "properties": {
          "bbox": {
            "$ref": "#/components/schemas/BBox"
          },
          "class_key": {
            "title": "Class Key",
            "type": "string"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "default_category": {
            "enum": [
              "biodegradable",
              "recyclable",
              "residual",
              "hazardous"
            ],
            "title": "Default Category",
            "type": "string"
          }
        },
        "required": [
          "class_key",
          "confidence",
          "bbox",
          "default_category"
        ],
        "title": "Detection",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "model_loaded": {
            "title": "Model Loaded",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "model_loaded"
        ],
        "title": "Health",
        "type": "object"
      },
      "ImageSize": {
        "properties": {
          "height": {
            "title": "Height",
            "type": "integer"
          },
          "width": {
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "width",
          "height"
        ],
        "title": "ImageSize",
        "type": "object"
      },
      "ModelInfo": {
        "properties": {
          "classes": {
            "items": {
              "$ref": "#/components/schemas/ClassInfo"
            },
            "title": "Classes",
            "type": "array"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "thresholds": {
            "$ref": "#/components/schemas/Thresholds"
          }
        },
        "required": [
          "model_version",
          "classes",
          "thresholds"
        ],
        "title": "ModelInfo",
        "type": "object"
      },
      "Thresholds": {
        "properties": {
          "confident": {
            "title": "Confident",
            "type": "number"
          },
          "min": {
            "title": "Min",
            "type": "number"
          },
          "possible": {
            "title": "Possible",
            "type": "number"
          }
        },
        "required": [
          "confident",
          "possible",
          "min"
        ],
        "title": "Thresholds",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "iTapon ML API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/detect": {
      "post": {
        "operationId": "detect_v1_detect_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_detect_v1_detect_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Detect"
      }
    },
    "/v1/model": {
      "get": {
        "operationId": "model_info_v1_model_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Model Info"
      }
    }
  }
}
