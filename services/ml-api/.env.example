# Copy to .env for local dev. On Hugging Face, set these as Space Secrets/Variables.

# Comma-separated origins allowed to call the API (Vercel prod + previews + local)
ALLOWED_ORIGINS=http://localhost:3000

# Phase 8: model weights on the Hugging Face Hub
MODEL_REPO=<hf-username>/itapon-yolo
MODEL_REVISION=main
# HF_TOKEN=   # only if the model repo is private
