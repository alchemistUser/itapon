# Copy to .env for local dev. On Hugging Face, set these as Space Variables/Secrets.
# Every value has a working default; override only what you need.

# Comma-separated origins allowed to call the API (Vercel prod + previews + local)
ALLOWED_ORIGINS=http://localhost:3000

# Model weights (built by scripts/build_world_model.py; baked into the Docker image)
WEIGHTS_PATH=weights/itapon-world-v0.pt

# Detection tuning (zero-shot YOLO-World scores run lower than a trained model's)
MIN_CONFIDENCE=0.10        # lowest score returned at all
POSSIBLE_THRESHOLD=0.15    # client shows "Possibly X"
CONFIDENT_THRESHOLD=0.35   # client shows the result confidently
IOU_THRESHOLD=0.5
MAX_DETECTIONS=10
IMAGE_SIZE=640
MAX_UPLOAD_BYTES=2097152
