# Normalize line endings so Windows and macOS/Linux teammates don't fight over CRLF/LF
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.pt binary
*.onnx binary

# Byte-identical copy of the model labels file: its SHA-256 is pinned (see models.ts); no EOL conversion
apps/web/src/lib/archive-classifier/labels.json -text
