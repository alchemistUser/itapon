# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated assets (scripts/copy-ort.mjs, scripts/copy-models.mjs)
/public/ort/
/public/models/
