# Copy to .env.local and fill in. Real values live in the Vercel dashboard.
# NEXT_PUBLIC_* values are exposed to the browser. Never put secrets in them.

# In-browser model files (D12). Optional override: by default dev uses /models
# (scripts/copy-models.mjs) and production uses the tag pinned in src/lib/detector/models.ts
# (https://huggingface.co/alchemistUserhf/itapon-yolo/resolve/v0.1).
# NEXT_PUBLIC_MODEL_BASE_URL=

# Supabase, Phase 10 (anon key is public by design; RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public source link required by AGPL-3.0 (footer)
NEXT_PUBLIC_SOURCE_URL=https://github.com/alchemistUser/itapon
